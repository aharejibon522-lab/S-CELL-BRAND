# Copy to your hosting provider's environment settings. None of these are required to run locally.

PORT=3000
NODE_ENV=production
DB_PATH=./data/scell.db

# First admin account (created on first start only)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-long-password

# Secret used to hash NID numbers. Set once and never change it.
NID_HASH_KEY=change-me-to-a-long-random-string

# Demo content: fictional artists and collectors. Set to false for launch.
SEED_DEMO=true

# Sandbox only: approve identity checks automatically.
KYC_AUTO_APPROVE=false

# ---- Open business decisions (Master Plan v4.0) ----
# Secure-transfer charge paid by the buyer on resales. 0 switches it off.
TRANSFER_FEE_PCT=2.5
TRANSFER_FEE_MIN=300
# Maximum cards one person may hold per artist. 0 = no limit.
HOLDING_CAP=0
# Minimum step above the last price for a resale (settled range: 100–150).
MIN_PRICE_STEP=150
# Verification period in days (settled range: 3–5).
VERIFY_DAYS=3
# Price decay: starts after this many days unsold, then this % per year.
DECAY_START_DAYS=365
DECAY_PCT_PER_YEAR=10
# Starting price for every card at S/CELL Night.
AUCTION_RESERVE=1500
BID_INCREMENT=100
MEMBERSHIP_FEE=100
# Share of S/CELL's resale income that funds the Season Reward Pool.
REWARD_POOL_PCT=20
